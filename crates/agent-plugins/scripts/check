#!/bin/sh
# The Rust crate's checks from one entry point (docs/RUST.md): formatting, the lints, the tests
# (the differential ones hold the crate to the vectors recorded from the npm package), the
# documentation with its warnings denied, every port and the vectors current with their sources
# and the pinned spec (RS9), the coverage report being current, and what a package
# would carry. Recording the vectors is not among them: `bun scripts/rust/record.ts`.
#
#   crates/agent-plugins/scripts/check     every check, in order; stops at the first failure
set -eu
cd "$(dirname "$0")/../../.."
step() { printf '\n== %s\n' "$*"; "$@"; }
step cargo fmt --check
step cargo clippy --locked --all-targets -- -D warnings
step cargo test --locked
RUSTDOCFLAGS='-D warnings' step cargo doc --locked --no-deps --package agent-plugins
step bun scripts/rust/ports.ts --check
step bun scripts/rust/coverage.ts --check
printf '\n== cargo package --list\n'
listed=$(cargo package --list --locked --allow-dirty --package agent-plugins)
stray=$(printf '%s\n' "$listed" | grep -Ev '^(src/|(README|CHANGELOG)\.md$|Cargo\.(toml|toml\.orig|lock)$|\.cargo_vcs_info\.json$)' || true)
if [ -n "$stray" ]; then
    printf 'the package would carry:\n%s\n' "$stray"
    exit 1
fi
printf '\nall checks passed\n'
